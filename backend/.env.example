# App Configuration
PROJECT_NAME="Enterprise AI Resume Screening Platform"
ENVIRONMENT="development"
PORT=3000

# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-host-name.neon.tech/dbname?sslmode=require"

# Security Configuration (JWT keys can be generated using openssl rand -hex 32)
JWT_SECRET_KEY="supersecretjwtkeyforresume-screening-platform-access-token"
JWT_REFRESH_SECRET_KEY="supersecretjwtkeyforresume-screening-platform-refresh-token"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google GenAI Configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
