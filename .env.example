# =========================================================================
# TALENTSYNC ENTERPRISE PLATFORM ENVIRONMENT CONFIGURATION
# =========================================================================
# Copy this file to '.env' and fill in your real credentials.
# Do NOT commit your real '.env' file containing secrets to source control.

# -------------------------------------------------------------------------
# General Configuration
# -------------------------------------------------------------------------
PROJECT_NAME="Enterprise AI Resume Screening Platform"
ENVIRONMENT="production" # Use 'development' or 'production'
PORT=3000

# -------------------------------------------------------------------------
# Database Configuration (Neon PostgreSQL)
# -------------------------------------------------------------------------
# Replace with your actual database connection string from Neon.
# Note: For production, ensure '?sslmode=require' is attached to the string.
# Leave empty to fall back to the built-in JSON file-system database sandbox!
DATABASE_URL="postgresql://user:password@ep-host-name.neon.tech/dbname?sslmode=require"

# -------------------------------------------------------------------------
# AI Integration (Google Gemini API)
# -------------------------------------------------------------------------
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="AI_STUDIO_INJECTED_KEY"

# -------------------------------------------------------------------------
# Security & Token Configurations
# -------------------------------------------------------------------------
# Generate secure random hex keys using: openssl rand -hex 32

# Node.js Express server token key
JWT_SECRET="enterprise-secure-jwt-secret-key-1337-replace-me"

# Python FastAPI backend token keys
JWT_SECRET_KEY="enterprise-secure-jwt-secret-key-1337-replace-me"
JWT_REFRESH_SECRET_KEY="enterprise-secure-jwt-refresh-secret-key-1337-replace-me"

# Token Expiry windows
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------------------
# SMTP Email Configuration
# -------------------------------------------------------------------------
# SMTP host server (e.g. smtp.gmail.com, smtp.mailtrap.io)
SMTP_HOST=""
# SMTP port (e.g. 587 for STARTTLS, 465 for SSL)
SMTP_PORT="587"
# SMTP credentials username
SMTP_USER=""
# SMTP credentials password or App Password
SMTP_PASS=""
# Sender email address (e.g. noreply@talentsync.ai)
SMTP_FROM_EMAIL=""
# Sender displayed name (e.g. TalentSync Alerts)
SMTP_FROM_NAME="TalentSync Notification Service"

